generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AUDITOR
  EXECUTIVE
  // Admin checklist-review refresh — an auditor who ALSO reviews/approves checklists + views
  // dashboards, without the full ADMIN template/era/station/user-management surface. See
  // apps/api/src/*/*.controller.ts's hand-coded role checks for exactly which routes admit it.
  REVIEWER
}

enum ChecklistStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CoordSource {
  OFFICIAL  // authoritative government/operator data
  GEOCODED  // derived from province/district centroid
  MANUAL    // hand-placed by admin
  NONE      // no coordinate data available
  // Station masterlist cutover (tools/station-masterlist/convert_masterlist.py) — provenance
  // of coordinates resolved from Merged_Station_Coordinates_V2.xlsx.
  NATIVE    // workbook's own ละติจูด/ลองจิจูด columns
  FILE2     // workbook's X_File2/Y_File2 columns, already WGS84
  FILE2_UTM // X_File2/Y_File2 detected as UTM zone 47N (EPSG:32647), converted to WGS84
}

enum CoordStatus {
  OK             // real, station-specific coordinate
  APPROXIMATE    // centroid fallback or rough area
  PENDING        // not yet verified
  INVALID        // known bad value (e.g. 0,0)
  PENDING_COORDS // masterlist cutover: station exists but no source had usable coordinates —
                 // never gets a fabricated fallback; blocked from the proximity gate until a
                 // human supplies real coordinates.
}

enum StationScope {
  IN_SCOPE
  OUT_OF_SCOPE
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  displayName  String?
  role         UserRole  @default(AUDITOR)
  isActive     Boolean   @default(true)
  // UDT-53 — "sys admin" bit on top of ADMIN. An ADMIN with this set governs user management
  // (may manage admin-tier accounts + grant ADMIN/this bit); a plain ADMIN may only manage
  // non-admin accounts. Only ever meaningful when role === 'ADMIN'. Enforced in users.service.ts.
  isSuperAdmin Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Part G.2 (W2-S1) — responsible agency this user belongs to (values from
  // RESPONSIBLE_AGENCIES, @repo/types). Nullable: existing users have none until an admin sets
  // it. Agency-scoped data filtering is deliberately out of scope for now.
  agency       String?

  checklists Checklist[]
}

model Station {
  id                String    @id @default(cuid())
  name              String
  nameTh            String
  mode              String    // 'ทางบก' | 'ทางราง' | 'ทางน้ำ' | 'ทางอากาศ'
  railSubtype       String?   // 'รถไฟฟ้า' | 'รถไฟ' (rail only)
  // Station masterlist cutover — line/route the station sits on (สาย/เส้นทาง), e.g. a metro
  // line. Empty string (never null) when the source row had none: identity is (mode, nameTh,
  // line), and Postgres composite unique indexes treat NULL as distinct-from-itself, which
  // would silently defeat the uniqueness guarantee for the common no-line case.
  line              String    @default("")
  // Station masterlist cutover — ประเภทสถานี raw value (e.g. สถานีรถไฟฟ้า, ท่าเรือโดยสาร);
  // railSubtype above is derived from this for rail rows.
  stationType       String?
  province          String?   // nullable: masterlist has no province for ~447 rail rows — never fabricate one
  region            String?   // nullable alongside province — region is derived FROM province
  responsibleAgency String
  lat               Float?
  lng               Float?
  coordSource       CoordSource @default(NONE)
  coordStatus       CoordStatus @default(PENDING)
  // Station masterlist cutover provenance (see tools/station-masterlist/convert_masterlist.py) —
  // kept for future coordinate disputes, not consumed by app logic.
  coordMatchStatus  String?
  matchedNameFile2  String?
  scope             StationScope @default(IN_SCOPE)
  isOperational     Boolean   @default(true)
  sourceFile        String?
  sourceId          String?
  score             Float     @default(0)
  status            String    @default("ต้องปรับปรุง")
  lastInspected     DateTime?
  urgentIssues      String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // E-form redesign (Session E2, Part A) — Buddhist year, captured by the AUDITOR in the field
  // (not master data from สนข.) at confirm-to-start; editable on later audits. Drives era
  // resolution — see @repo/types#resolveEra. Every change writes an AuditLog entry.
  yearBuilt         Int?

  // 2026-08-05 — exact building-permit-application date, GREGORIAN, when the auditor can find it
  // (e.g. on a permit placard at the station). Optional REFINEMENT over yearBuilt, never a
  // replacement: yearBuilt alone stays sufficient and required to start an audit (see
  // ChecklistsService.assertYearBuiltPresent). Only resolves era comparisons more precisely when
  // both this AND a LawReference.effectiveDate are present for the laws in question — see
  // @repo/types#isLawInForce. Null is the overwhelmingly common case and must stay silently fine.
  yearBuiltDate     DateTime? @db.Date

  // Session S3b, Part A — marks a station as a practice/tutorial fixture, never a real
  // inspection target. Always OUT_OF_SCOPE (seed-training-stations.ts enforces this), so most
  // aggregates already exclude it via `scope`; queries that don't scope by IN_SCOPE (map nodes,
  // summary counts, filter dropdowns, the auditor picker) filter on this flag explicitly instead —
  // see StationsService/AdminService call sites tagged "Part A" for the full list.
  isTraining        Boolean   @default(false)

  checklists Checklist[]

  // Station masterlist cutover — identity is (mode, name, line), never name alone: 30+ stations
  // legitimately share a name across lines/modes. Replaces the pre-cutover
  // [nameTh, mode, responsibleAgency, province] key (province is no longer reliably present).
  @@unique([mode, nameTh, line])
}

// E-form redesign (Session E1, Part A) — versioned checklist form definitions.
// Exactly ONE ACTIVE row per (mode, variantKey) is enforced in service logic (a DB constraint
// can't express "at most one row where status=X" without a partial index scoped to a single
// literal, which Prisma's schema DSL can't declare — see migrations/*_eform_templates for the
// rationale, matching the project's existing migrations_manual/ precedent for PG features the
// schema DSL can't represent).
//
// variantKey defaults to 'standard'; future year-built law-era variants (Part A2.5) are added as
// new rows keyed by a different variantKey — never a schema change. definition: JSON, validated
// at seed/write time by @repo/types#parseTemplateDefinition, never trusted blindly at read time
// by callers that score against it.
model ChecklistTemplate {
  id         String         @id @default(cuid())
  mode       String
  variantKey String         @default("standard")
  version    Int
  status     TemplateStatus @default(DRAFT)
  definition Json
  notes      String?
  createdAt  DateTime       @default(now())

  checklists Checklist[]

  @@unique([mode, variantKey, version])
}

// Session S5, Part A — master/reference criterion nodes for the facility-grouped editor's pilot
// source-of-truth inversion (see apps/api/src/admin/templates/master-criteria.core.ts's module doc
// for the full design). A MasterCriterion holds the write-through payload for ONE canonical item
// shared across N TemplateNode leaves (identified by TemplateNode.masterId, a plain string
// reference — not a Prisma relation, since TemplateNode lives inside ChecklistTemplate.definition's
// JSON blob, never a row of its own, same as how LawReference.code is already referenced from
// inside that JSON without an FK).
//
// Deliberately NO code/num/position fields: those stay per-instance always (a master describes
// CONTENT — what the item asks and requires — never WHERE it sits in any one template's tree).
model MasterCriterion {
  id                String   @id @default(cuid())
  labelTh           String
  answerType        String?
  measurements      Json?
  guidance          Json?
  imageKeys         String[]
  lawRefs           String[]
  cabinetResolution Boolean?
  beyondLaw         Boolean?
  facilityCode      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

// E-form redesign (Session E1, Part A2.1) — PROVISIONAL law registry seeded from the สนข. draft
// comparison table "Checklist ตามปี" (2566-04 revision). `code` is a stable identifier — do not
// rename; only nameTh/ministry corrections are expected. effectiveYear is nullable: enforcement
// start dates need สนข. confirmation and must never be guessed from the Buddhist year in nameTh.
model LawReference {
  id            String   @id @default(cuid())
  code          String   @unique
  nameTh        String
  ministry      String
  buddhistYear  Int
  effectiveYear Int?
  // 2026-08-05 — exact enforcement date, GREGORIAN, when known (see facility-catalog.ts's
  // LAW_REFERENCE_SEED for the 3 rows that currently carry one). Refines effectiveYear only for
  // era comparisons where a Station also carries an exact yearBuiltDate — see
  // @repo/types#isLawInForce. Nullable, never guessed, same rule as effectiveYear.
  effectiveDate DateTime? @db.Date
  notes         String?
  createdAt     DateTime @default(now())
}

// Stores one checklist submission (draft or submitted) per station per auditor session.
// items: JSON snapshot of ChecklistGroup[] at submission time.
//
// Two partial unique indexes enforce "one DRAFT" and "one pending-review SUBMITTED" per
// (stationId, auditorId) — see migrations/20260718170200_checklist_draft_submit_uniqueness.
// Not representable here: Prisma's schema DSL has no partial-index (WHERE-scoped @@unique)
// syntax, so they exist only as raw SQL in migration history, same category as the PostGIS
// geography column in migrations_manual/ (a Postgres feature the DSL can't declare).
model Checklist {
  id          String          @id @default(cuid())
  stationId   String
  station     Station         @relation(fields: [stationId], references: [id])
  auditorId   String
  auditor     User            @relation(fields: [auditorId], references: [id])
  items       Json
  score       Float?
  status      ChecklistStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // E-form redesign (Session E1, Part A.4) — the template this checklist was filled against.
  // Nullable only because pre-E1 pilot rows are backfilled after the fact (see migrations/
  // *_eform_backfill); every NEW checklist stamps the mode's current ACTIVE template at creation
  // and this stamp NEVER changes afterward — an audit is a record against the form it was filled
  // on, not a live pointer that drifts when the template is later revised.
  templateId      String?
  template        ChecklistTemplate? @relation(fields: [templateId], references: [id])
  templateVersion Int?

  // Part C — auditor's free-text closing remarks on the submission. Nullable; length-capped at
  // the DTO layer (4000 chars), not here.
  finalThoughts String?

  // E-form redesign (Session E2, Part A) — era-resolution stamp, alongside the existing
  // templateId/templateVersion stamp above. Set once at checklist creation (saveDraft's create
  // branch, or submit() when no prior draft exists) from the station's yearBuilt AT THAT MOMENT;
  // NEVER changes afterward — a corrected station year affects only future checklists, not this
  // one. appliedLawRefs is keyed `${leafCode}#${measurementKey}` -> resolved LawReference.code
  // (see @repo/types#resolveTemplateEras); null when the template had no byLaw-varying leaves,
  // same graceful-degradation as a null templateId.
  appliedYearBuilt Int?
  appliedLawRefs   Json?
  // 2026-08-05 — frozen alongside appliedYearBuilt, from the station's yearBuiltDate AT THAT
  // MOMENT (same never-changes-afterward rule). Null whenever the station had no exact date
  // captured yet — the overwhelmingly common case — in which case resolution used (and this
  // checklist is forever pinned to) the year-only comparison.
  appliedYearBuiltDate DateTime? @db.Date

  // Admin review outcome — set when an ADMIN rejects a SUBMITTED checklist and
  // sends it back to the auditor with feedback. Null until a reject happens.
  reviewNotes String?
  reviewedAt  DateTime?

  // Submit-time GPS audit trail (Phase 1 proximity gate) — null for DRAFTs and for any
  // checklist submitted before this field existed. Never trust these for re-verification;
  // they're a record of what the server checked at submit time, not a live source of truth.
  gpsLat            Float?
  gpsLng            Float?
  gpsAccuracy       Float?
  gpsDistanceM      Float?
  locationVerified  Boolean?
  proximityBypassed Boolean?

  // Session F3, Part H — START-time GPS audit trail. สนข. 2026-08-03 moved the proximity gate from
  // submit to START ("กดเข้าไปทำได้แค่ตอนอยู่ใกล้สถานี ... แล้วสามารถส่งจากที่ไหนก็ได้"), so the
  // submit-time fields above NO LONGER prove the auditor was at the station — these do.
  //
  // Added as NEW columns rather than repurposing the existing ones on purpose: rows written before
  // F3 have a submit-time reading that WAS gated, and rows written after have one that wasn't.
  // Overloading the same columns would make those two cases indistinguishable after the fact and
  // silently rewrite the meaning of every historical row. A row with startLocationVerified = null
  // is therefore exactly "created before F3" (or a training/bypass case, per the flags below).
  //
  // Stamped once, at the moment the checklist row is CREATED (saveDraft's create branch, or a
  // no-prior-draft submit — the two paths that can start an inspection), and never touched again.
  startGpsLat            Float?
  startGpsLng            Float?
  startGpsAccuracy       Float?
  startGpsDistanceM      Float?
  startLocationVerified  Boolean?
  startProximityBypassed Boolean?

  // Session S3b, Part A — stamped from Station.isTraining at creation (saveDraft/submit), never
  // recomputed afterward. A denormalized copy, not a derived read through `station`, so every
  // aggregate that already filters Checklist rows directly (never joining Station) can exclude
  // training data with one flat `where` clause instead of a join.
  isTraining Boolean @default(false)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}
